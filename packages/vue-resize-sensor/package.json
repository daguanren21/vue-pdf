  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/vue-pdf.git",
