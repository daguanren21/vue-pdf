{
  "name": "@daguanren21/vue-pdf-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @daguanren21/vue-pdf-playground dev",
    "build": "pnpm -r --filter=./packages/* build",
    "build:pdf": "pnpm --filter @daguanren21/vue-pdf build",
    "build:sensor": "pnpm --filter @daguanren21/vue-resize-sensor build",
    "playground": "pnpm --filter @daguanren21/vue-pdf-playground dev",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm --filter @daguanren21/vue-pdf test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@types/node": "^26.1.1",
    "@vue/test-utils": "1",
    "happy-dom": "^20.11.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 || >=22",
    "pnpm": ">=10"
  }
}
